# Salin nilai ini dari dashboard Supabase kamu: Settings > API
# Project URL (contoh: https://xxxxx.supabase.co)
SUPABASE_URL=

# "service_role" secret key (BUKAN yang "anon public")
# Klik "Reveal" di dashboard untuk melihatnya.
SUPABASE_SERVICE_KEY=

# Kunci rahasia untuk mengenkripsi session login. Isi bebas string acak yang panjang.
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia

# --- Notifikasi Email (Gmail) ---
# Alamat Gmail pengirim notifikasi ke pendaftar
EMAIL_USER=
# App Password Google (16 huruf, TANPA spasi) -- bukan password Gmail biasa.
# Buat di https://myaccount.google.com/apppasswords (Verifikasi 2 Langkah harus aktif)
EMAIL_APP_PASSWORD=
